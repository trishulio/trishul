<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    <Or>
        <!-- 1. All framework-style / DI classes -->
        <Class name="~.*(Service|Client|Manager|Provider|Controller|Configuration|Executor|Wrapper|Register|Delegate|Decorator|Repository|Repo|Resolver|Util|Builder|Mapper|Filter)" />
        <!-- 2. Entire internal packages where exposure is acceptable -->
        <Class name="~sh\.trishul\..*\.(service|client|manager|provider|controller|config|executor|wrapper|delegate|repository|filters)\..*" />
        <!-- 3. Known framework / infra types (instead of Parameter filters) -->
        <Class name="~(javax|jakarta|org\.springframework|com\.amazonaws)\..*" />
        <!-- 4. Models / DTOs (if you want blanket allowance) -->
        <Class name="~sh\.trishul\..*\.model\..*" />
    </Or>
</Match>

    <!-- Ignore all bugs for Test Mocks -->
    <Match>
    <Class name="~sh\.trishul\.test\..*Mock.*"/>
</Match>

    <!-- SQL_INJECTION_JDBC is expected in Jdbc Dialect classes as they are trusted classes used by trusted classes -->
    <Match>
        <Bug pattern="SQL_INJECTION_JDBC" />
        <Class name="~sh\.trishul\.dialect\.postgres\.PostgresJdbcDialect.*" />
    </Match>
</FindBugsFilter>
